{
  "settings": {
    "db_path": "/tmp/{fold}.sqlite"
  },
  "store": {
    "credential_kind": "sigv4",
    "node": 7,
    "usage": {
      "bucket": "conf-usage",
      "window": 1700000000
    },
    "schema": "conf-schema",
    "keys": {
      "grouped": "vk_conf_grouped",
      "group": "conf-group",
      "plain": "vk_conf_plain",
      "absent": "vk_conf_absent"
    }
  }
}
